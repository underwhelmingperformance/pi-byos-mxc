{
	"name": "pi-byos-mxc",
	"version": "0.0.0",
	"private": true,
	"description": "An experimental Microsoft MXC sandbox provider for Pi BYOS",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "24.22.2"
	},
	"exports": {
		".": {
			"types": "./dist/extension.d.ts",
			"import": "./dist/extension.js"
		},
		"./pi-tools": {
			"types": "./dist/pi-tools.d.ts",
			"import": "./dist/pi-tools.js"
		},
		"./diagnostics": {
			"types": "./dist/diagnostics.d.ts",
			"import": "./dist/diagnostics.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/extension.js"
		]
	},
	"files": [
		"dist",
		"README.md",
		"docs"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"check": "pnpm build && pnpm run --sequential '/^check:.*/'",
		"check:format": "prettier --check .",
		"check:knip": "knip --include dependencies,unlisted --no-progress",
		"check:lint": "eslint . --max-warnings 0",
		"check:markdown": "markdownlint-cli2 '**/*.md' '#node_modules' '#dist'",
		"check:test": "pnpm test",
		"check:types": "tsc --noEmit",
		"test": "vitest run",
		"test:provider": "pnpm build && vitest run --config vitest.provider.config.ts",
		"test:network": "pnpm build && vitest run --config vitest.network.config.ts",
		"fix:format": "prettier --write .",
		"fix:lint": "eslint . --fix"
	},
	"dependencies": {
		"@microsoft/mxc-sdk": "1.0.1",
		"pi-bring-your-own-sandbox": "file:../pi-bring-your-own-sandbox"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "24.12.2",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-unicorn": "79.0.0",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"knip": "6.43.0",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.9",
		"typebox": "1.3.27",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	}
}
