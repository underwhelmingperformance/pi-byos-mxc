{
	"name": "pi-byos-mxc",
	"version": "0.0.0",
	"private": true,
	"description": "An experimental Microsoft MXC sandbox provider for Pi BYOS",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^24.21.0"
	},
	"exports": {
		".": {
			"types": "./dist/mxc.d.ts",
			"import": "./dist/mxc.js"
		},
		"./diagnostics": {
			"types": "./dist/diagnostics.d.ts",
			"import": "./dist/diagnostics.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/mxc.js"
		]
	},
	"files": [
		"dist",
		"README.md",
		"docs"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && sh script/build-native.sh && node script/build-tools.ts",
		"check": "pnpm build && pnpm run --sequential '/^check:.*/'",
		"check:format": "prettier --check .",
		"check:knip": "knip --no-progress",
		"check:lint": "eslint . --max-warnings 0",
		"check:markdown": "markdownlint-cli2 '**/*.md' '#node_modules' '#dist' '#.git'",
		"check:test": "pnpm test",
		"check:types": "tsc --noEmit",
		"test": "vitest run",
		"test:provider": "pnpm build && vitest run --config vitest.provider.config.ts",
		"test:network": "pnpm build && vitest run --config vitest.network.config.ts",
		"fix:format": "prettier --write .",
		"fix:lint": "eslint . --fix",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"check:integration": "pnpm test:integration"
	},
	"dependencies": {
		"@microsoft/mxc-sdk": "1.0.1",
		"pi-bring-your-own-sandbox": "github:underwhelmingperformance/pi-bring-your-own-sandbox#caf09630558859d62c34b3242db865756b80bec3&path:/packages/sdk",
		"re2js": "^2.10.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "24.12.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-unicorn": "79.0.0",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"knip": "6.43.0",
		"markdownlint-cli2": "0.23.2",
		"memfs": "4.80.0",
		"prettier": "3.10.1",
		"rolldown": "1.2.16",
		"typebox": "1.3.27",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.1"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"typebox": "^1.3.27"
	},
	"bundleDependencies": [
		"pi-bring-your-own-sandbox"
	],
	"license": "MIT"
}
